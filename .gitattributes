# Normalize text files across Windows, macOS, and Linux.
* text=auto eol=lf

# Keep Windows command scripts compatible with Windows shells.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat generated and image assets as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
